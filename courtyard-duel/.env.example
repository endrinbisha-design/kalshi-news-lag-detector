# All optional. Defaults shown.
PORT=8080
HOST=0.0.0.0
# Set to 1 when running behind a reverse proxy / PaaS (uses X-Forwarded-For for per-IP rate limits)
TRUST_PROXY=0
# Send Strict-Transport-Security (only when you serve over HTTPS)
HSTS=0
# Extra allowed WebSocket origins, comma separated. Default: the page's own origin only.
ALLOWED_ORIGINS=
# Match rules
WIN_ROUNDS=10
PREP_TIME_SEC=10
ROUND_TIME_SEC=90
ROUND_END_SEC=4
RECONNECT_GRACE_SEC=120
# Capacity / hygiene
MAX_ROOMS=500
ROOM_TTL_MIN=30
MAX_CONN_PER_IP=8
# Testing only: simulated one-way latency (ms) and jitter applied to every message
SIM_LATENCY_MS=0
SIM_JITTER_MS=0
