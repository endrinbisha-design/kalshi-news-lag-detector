# ---------------------------------------------------------------------------
# Kalshi News-Lag Detector — example environment file
#
# Copy this to `.env` (which is gitignored) and fill in real values.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Kalshi API (v2) ---
# Create an API key in the Kalshi dashboard: Profile -> API Keys.
# You get a Key ID (a UUID) and download an RSA private key (.pem) ONCE.
# TODO: paste your key ID and point at the downloaded .pem file.
KALSHI_API_KEY_ID=00000000-0000-0000-0000-000000000000
KALSHI_PRIVATE_KEY_PATH=./kalshi_private_key.pem

# API host. Production (real markets) is the default below.
#   Production: https://api.elections.kalshi.com/trade-api/v2
#   Demo:       https://demo-api.kalshi.co/trade-api/v2
KALSHI_API_BASE=https://api.elections.kalshi.com/trade-api/v2

# --- NewsAPI.org ---
# Get a free key at https://newsapi.org/register
# TODO: paste your NewsAPI key.
NEWSAPI_KEY=your_newsapi_key_here

# --- Anthropic (Claude) — used for relevance/impact scoring ---
# TODO: paste your Anthropic API key.
ANTHROPIC_API_KEY=your_anthropic_key_here

# Model used for scoring. See README for options.
ANTHROPIC_MODEL=claude-sonnet-5

# --- Detector tuning (optional; config.yaml overrides these if present) ---
# Flag a market when |fair_price - market_price| exceeds this many percentage points.
GAP_THRESHOLD_PP=5
